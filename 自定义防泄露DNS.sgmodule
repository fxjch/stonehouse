#!name = 自定义防泄露DNS
#!desc = 自定义防泄露DNS

[General]
DNS.js = type=dns,script-path=https://raw.githubusercontent.com/xream/scripts/main/surge/modules/dns/build/index.js,desc=DNS.js,argument="type=A,AAAA&doh=https://8.8.4.4/dns-query, https://8.8.8.8/dns-query,https://dns11.quad9.net/dns-query&ttl=60&timeout=2&edns=114.114.114.114&log=1&fallback=1&policy=Apple"

[Host]
RULE-SET:Rule/Domestic_Set.txt = server:syslib
* = script:DNS.js